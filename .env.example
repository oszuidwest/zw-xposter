# X session (auth_token cookie required; no automated password login)
X_USERNAME=
X_AUTH_TOKEN=
# Optional override of the browser-compatible User-Agent used by HTTP requests.
# X_USER_AGENT=

# Orchestrator (optional)
# FEED_URL=https://www.zuidwestupdate.nl/feed/
# HTTPS downloads only; allow CDN and redirect hosts here. Private IPs are blocked.
# ALLOWED_HOSTS=media.example.nl,cdn.example.nl
# Minimum: 30s.
# POLL_INTERVAL=2m
# Delay between posts; zero disables it.
# POST_DELAY=30s
# Greater than zero, at most 312h.
# MAX_AGE=24h
# Replace a post with a video post when the feed adds a video within this time
# after publication; the earlier post is deleted. Zero disables replacement.
# VIDEO_REPLACE_WINDOW=6h
# Local preparation only: no posts, paid transcription, state writes, alerts or heartbeats.
# Predicted fallback only; captions/uploads/X API outcomes stay unverified.
# Manual /post needs dryRun: true.
# DRY_RUN=true

# Optional Dutch captions (paid); enable the key's Speech to Text permission.
# Fallback: captioned video -> video -> article image -> text/link, even for temporary media failures.
# Post-click service failures retain captions until a retry after checking X.
# Retries resume the saved format. Before downgrade, another retry may incur transcription charges.
ELEVENLABS_API_KEY=

# Operational monitoring (optional)
# Heartbeat sent after each successful poll; use an external downtime monitor.
# HEARTBEAT_URL=https://heartbeat.example.invalid/ping/example
# Login alerts can take about 90 minutes due to periodic session checks.
# POSTER_NOT_READY_AFTER=30m
# POLL_STALE_AFTER=15m
# ALERT_REMINDER_INTERVAL=24h

# Microsoft Graph alerts (optional; requires all values and Mail.Send application permission with admin consent)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_FROM_ADDRESS=
ALERT_RECIPIENTS=
