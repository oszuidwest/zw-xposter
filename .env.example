# X account the poster logs in with.
X_USERNAME=
# Prefer the auth_token cookie from a logged-in session; X may block new password logins.
X_AUTH_TOKEN=
# Fallback when the session has expired.
X_PASSWORD=
# Account email or phone for X's optional "unusual login activity" check.
X_VERIFICATION=

# Orchestrator (optional)
# FEED_URL=https://www.zuidwestupdate.nl/feed/
# Downloads require HTTPS and the feed host or an allowed host; private IPs are blocked.
# ALLOWED_HOSTS=media.example.nl,cdn.example.nl
# Minimum poll interval: 30s. Article age limit: greater than zero, at most 312h.
# POLL_INTERVAL=2m
# Delay between post attempts; zero disables the delay, negative values are rejected.
# POST_DELAY=30s
# MAX_AGE=24h
# Disables automatic posts, state writes, alerts and heartbeats.
# Manual requests to the poster's /post endpoint still need dryRun: true.
# DRY_RUN=true

# Browser (optional)
# HEADLESS=false
# SCREEN_SIZE=1920x1080
# WINDOW_SIZE=1440x960
# BROWSER_LANGUAGES=nl-NL,nl,en-US,en

# Operational monitoring (optional)
# Heartbeat sent after each successful poll; use an external monitor to detect downtime.
# HEARTBEAT_URL=https://heartbeat.example.invalid/ping/example
# Session checks run every 30–60 minutes, so login alerts can take about 90 minutes.
# POSTER_NOT_READY_AFTER=30m
# POLL_STALE_AFTER=15m
# ALERT_REMINDER_INTERVAL=24h

# Microsoft Graph alert e-mail (optional; all values are required to enable it)
# The app registration needs the application permission Mail.Send with admin consent.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_FROM_ADDRESS=
ALERT_RECIPIENTS=
